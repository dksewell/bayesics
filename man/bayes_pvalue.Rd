# Use a custom test statistic
bp_sw = 
  bayes_pvalue(fit,
               statistic = 
                 function(y,mu,dispersion){
                   shapiro.test((y - mu)/sqrt(dispersion))$statistic
                 }
  )
bp_sw$bpvalue
